# Only production build inputs belong in the context.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!next.config.ts
!postcss.config.mjs
!tsconfig.json
!tsconfig.runtime.json
!src/**
!public/**
!drizzle/**
!scripts/package-standalone.mjs
!scripts/verify-image.mjs
!docker/entrypoint.sh
!tests/fixtures/runtime/images/sample.jpg
!tests/fixtures/runtime/images/sample.png

# Exclude local data and generated output even inside included directories.
**/.env*
**/.data
**/node_modules
**/.next
**/dist
**/*.db*
**/*.sqlite*
**/*.pem
**/*.key
**/*.tsbuildinfo
**/*.log
**/.DS_Store
