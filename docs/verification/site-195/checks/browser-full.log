{ phase: 'feedback', status: 'passed', checks: [ 'Native drag starts on photo surfaces and selects two cards without opening details; right-click retains an existing group or selects the new target; pointer menu, Escape focus, clear/reselect, Shift+F10 and keyboard detail opening work.', 'Browser Back while the context menu is open clears its previous query target; the next checkbox does not resurrect an old menu.', 'All six filter controls align at 44px/14px with centered 16px indicators. Six viewport widths in both themes keep four rounded card corners, no clipped content or horizontal overflow; grid fills without stretching and masonry matches actual decoded landscape/portrait thumbnails.', 'Right/bottom context menus fit the main boundary at desktop 1440×600 and mobile 390×844/560 in both themes; every action retains its required target size, keyboard navigation brings each enabled action fully into the visible scrolling menu, and Escape restores the card.' ], combinations: [ { theme: 'light', width: 360, layout: 'grid', status: 'passed' }, { theme: 'light', width: 360, layout: 'masonry', status: 'passed' }, { theme: 'light', width: 390, layout: 'grid', status: 'passed' }, { theme: 'light', width: 390, layout: 'masonry', status: 'passed' }, { theme: 'light', width: 430, layout: 'grid', status: 'passed' }, { theme: 'light', width: 430, layout: 'masonry', status: 'passed' }, { theme: 'light', width: 768, layout: 'grid', status: 'passed' }, { theme: 'light', width: 768, layout: 'masonry', status: 'passed' }, { theme: 'light', width: 960, layout: 'grid', status: 'passed' }, { theme: 'light', width: 960, layout: 'masonry', status: 'passed' }, { theme: 'light', width: 1440, layout: 'grid', status: 'passed' }, { theme: 'light', width: 1440, layout: 'masonry', status: 'passed' }, { theme: 'dark', width: 360, layout: 'grid', status: 'passed' }, { theme: 'dark', width: 360, layout: 'masonry', status: 'passed' }, { theme: 'dark', width: 390, layout: 'grid', status: 'passed' }, { theme: 'dark', width: 390, layout: 'masonry', status: 'passed' }, { theme: 'dark', width: 430, layout: 'grid', status: 'passed' }, { theme: 'dark', width: 430, layout: 'masonry', status: 'passed' }, { theme: 'dark', width: 768, layout: 'grid', status: 'passed' }, { theme: 'dark', width: 768, layout: 'masonry', status: 'passed' }, { theme: 'dark', width: 960, layout: 'grid', status: 'passed' }, { theme: 'dark', width: 960, layout: 'masonry', status: 'passed' }, { theme: 'dark', width: 1440, layout: 'grid', status: 'passed' }, { theme: 'dark', width: 1440, layout: 'masonry', status: 'passed' } ], screenshots: [ 'library-feedback-right-click-selection.png', 'library-feedback-light-390-grid.png', 'library-feedback-light-390-masonry.png', 'library-feedback-light-960-grid.png', 'library-feedback-light-960-masonry.png', 'library-feedback-light-1440-grid.png', 'library-feedback-light-1440-masonry.png', 'library-feedback-dark-390-grid.png', 'library-feedback-dark-390-masonry.png', 'library-feedback-dark-960-grid.png', 'library-feedback-dark-960-masonry.png', 'library-feedback-dark-1440-grid.png', 'library-feedback-dark-1440-masonry.png', 'library-feedback-menu-edge-light-1440x600.png', 'library-feedback-menu-edge-light-390x844.png', 'library-feedback-menu-edge-light-390x560.png', 'library-feedback-menu-edge-dark-1440x600.png', 'library-feedback-menu-edge-dark-390x844.png', 'library-feedback-menu-edge-dark-390x560.png' ], stage: 'geometry' }

{ phase: 'selection', status: 'passed', checks: [ 'HeroUI checkbox click and keyboard Space select without opening details; layout and detail return preserve selection without adding a gallery row.', 'Select-all covers all 80 loaded IDs with fewer mounted cards; appending the final 13 records leaves the explicit selection at 80.', 'Current-page select/deselect and Back preserve other-page IDs; the paged selected list renders 20 rows and removes an actual second-page entry.', 'Within one browser task, a large drag shrunk below the 5px movement threshold and immediately released removes only new drag hits, retaining the pre-drag current-page image and all 39 other-page IDs.', 'Search, sort and loading-mode changes each independently clear the previous explicit selection.', 'A manually checked image survives a real plain mouse drag; consecutive plain/Shift drags add intersecting cards, and Escape restores the pre-drag selection after adding a new fifth card; no detail opens or gallery shifts.', 'Two different mousemove events followed by Escape in the same browser task leave no queued rAF capable of overwriting the restored selection after two frames.', 'Light/dark desktop, mobile and short-viewport selection panels keep 44px touch checkboxes, visible controls, bounded width/height and Escape focus restoration.', 'Clearing all selections and removing the selected list’s final item both return focus to the existing search input.' ], combinations: [], screenshots: [ 'library-selection-cross-page-counts.png', 'library-selection-light-1440x1080.png', 'library-selection-touch-light-390x844.png', 'library-selection-light-390x844.png', 'library-selection-touch-light-390x560.png', 'library-selection-light-390x560.png', 'library-selection-dark-1440x1080.png', 'library-selection-touch-dark-390x844.png', 'library-selection-dark-390x844.png', 'library-selection-touch-dark-390x560.png', 'library-selection-dark-390x560.png' ] }

{ phase: 'selection-reconciliation', status: 'passed', checks: [ 'Normal desktop/mobile light/dark gallery and selected-popover screenshots contain at least two decoded production thumbnail images, seeded into the independent fixture storage.', '241 explicit IDs across four pages survive page select/deselect, Back/Forward and grid-to-masonry changes; newly displayed page records stay unselected until chosen.', 'The actual 201st selected item can be removed from page 11; selected-list pages mount only 20 rows and perform no list or reconciliation requests.', 'Real deletion, recycling and search mismatch remove exactly three choices across current and other pages after a domain change; the visible invalid card disappears, valid other-page choices persist, and a changed sort position, names and disabled-storage labels refresh.', 'Returning to the previously cached second page and traversing Back/Forward never restores invalid cards or their checkbox targets; valid selections survive in both cached pages.', 'A fresh production list response independently reconciles the selected IDs and removes a newly deleted off-page image without clearing valid choices.', 'A failed batch preserves all 236 explicit choices with an accessible error; retry reads the real API, removes the newly deleted ID and clears the error.', 'Real selected-list screenshots cover light/dark 360, 390, 430, 768, 1440 widths and a 390×560 short viewport; the panel has bounded dimensions, 44px mobile/tablet targets, initial keyboard focus and Escape focus restoration.', 'Both light/dark 390×560 panels fit a complete readable row; real wheel scrolling exposes a non-first selected row, opening and closing its detail retains all choices, and removing it decrements only the explicit selection.', 'Pending reconciliation disables selection actions; changing the search aborts its old request, and deliberately releasing that late successful response never recreates the old selection.', 'Network receipts show bounded POST batches containing only still-explicit selected IDs and an unpositioned query; successful responses are lightweight projections, with no all-library scans or original-image preloads.' ], combinations: [], screenshots: [ 'library-selection-reconciliation-normal-light-1440x1080.png', 'library-selection-reconciliation-normal-light-390x844.png', 'library-selection-reconciliation-normal-dark-1440x1080.png', 'library-selection-reconciliation-normal-dark-390x844.png', 'library-selection-reconciliation-updated-light-1440x1080.png', 'library-selection-reconciliation-notice-light-390x844.png', 'library-selection-reconciliation-notice-dark-390x844.png', 'library-selection-reconciliation-error-light-1440x1080.png', 'library-selection-reconciliation-error-light-390x844.png', 'library-selection-reconciliation-error-dark-390x844.png', 'library-selection-reconciliation-light-360x800.png', 'library-selection-reconciliation-light-390x844.png', 'library-selection-reconciliation-light-430x900.png', 'library-selection-reconciliation-light-768x1024.png', 'library-selection-reconciliation-light-1440x1080.png', 'library-selection-reconciliation-light-390x560.png', 'library-selection-reconciliation-dark-360x800.png', 'library-selection-reconciliation-dark-390x844.png', 'library-selection-reconciliation-dark-430x900.png', 'library-selection-reconciliation-dark-768x1024.png', 'library-selection-reconciliation-dark-1440x1080.png', 'library-selection-reconciliation-dark-390x560.png', 'library-selection-reconciliation-short-scrolled-light-390x560.png', 'library-selection-reconciliation-short-removed-light-390x560.png', 'library-selection-reconciliation-short-scrolled-dark-390x560.png', 'library-selection-reconciliation-short-removed-dark-390x560.png', 'library-selection-reconciliation-pending-dark-1440x1080.png', 'library-selection-reconciliation-empty-dark-1440x1080.png' ], reconciliation: { status: 'passed', records: 241, pageSize: 80, checks: [ 'Normal desktop/mobile light/dark galler