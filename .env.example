# 复制为 .env.local 后填写。此文件不包含可用密钥。
# HOST 默认 0.0.0.0；PORT 默认 3000，范围 1–65535。
# HOST=0.0.0.0
# PORT=3000
# DATA_DIR 默认 /data；本地开发请填写专用目录的绝对路径。
DATA_DIR=/absolute/path/to/ariso/.data
# LOG_LEVEL 默认 info；可选 trace/debug/info/warn/error/fatal。
# LOG_LEVEL=info
# 分别生成并保存两个独立密钥，勿使用 NEXT_PUBLIC_ 前缀或提交到 Git。
# 认证密钥至少 32 个字符。手动生成示例：
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# 加密密钥必须是 64 位十六进制字符串。另行生成：
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ARISO_ENCRYPTION_KEY=
# 完整开发入口读取此文件；Compose 固定使用容器内 /data。
