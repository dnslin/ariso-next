{
  "name": "ariso-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm run build:runtime && next build && node scripts/package-standalone.mjs",
    "start": "sh .next/standalone/entrypoint.sh",
    "build:runtime": "node scripts/build-metadata.mjs && tsc --project tsconfig.runtime.json",
    "dev": "pnpm run build:runtime && node --env-file=.env.local dist/cli/prestart.js && NEXT_EXIT_TIMEOUT_MS=6000 node --env-file=.env.local --import ./dist/cli/http.js --import ./dist/cli/shutdown.js node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:all": "pnpm --recursive --include-workspace-root run lint",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "typecheck": "next typegen && tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.runtime.json",
    "typecheck:all": "pnpm --recursive --include-workspace-root run typecheck",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:all": "pnpm --recursive --include-workspace-root run test",
    "check:all": "pnpm run lint:all && pnpm run typecheck:all && pnpm run test:all",
    "test:integration": "vitest run --project integration --project media-tools",
    "test:experiments": "vitest run --project experiments",
    "test:browser": "pnpm run build:shell && pnpm --dir tests/experiments/ui run build && node scripts/verify-browser.mjs",
    "build:shell": "next build tests/experiments/shell --webpack",
    "openapi:generate": "node scripts/generate-upload-openapi.ts",
    "openapi:check": "node scripts/generate-upload-openapi.ts --check"
  },
  "dependencies": {
    "@air/react-drag-to-select": "5.0.11",
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@better-auth/api-key": "1.7.5",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@gravity-ui/icons": "2.22.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "@resvg/resvg-js": "2.6.2",
    "@tanstack/react-query": "5.103.1",
    "@uppy/core": "5.2.0",
    "@uppy/xhr-upload": "5.2.0",
    "@xmldom/xmldom": "0.9.12",
    "age-encryption": "0.3.1",
    "better-auth": "1.7.5",
    "better-sqlite3": "13.0.3",
    "busboy": "1.6.0",
    "content-disposition": "3.0.0",
    "css-tree": "3.2.1",
    "drizzle-orm": "0.45.2",
    "execa": "10.0.1",
    "konva": "10.9.0",
    "lucide-react": "1.47.0",
    "motion": "14.1.0",
    "next": "16.4.1",
    "next-themes": "0.4.6",
    "nodemailer": "10.0.15",
    "nuqs": "2.10.1",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-is": "19.3.0",
    "react-konva": "19.3.2",
    "recharts": "3.10.1",
    "unicode-case-folding": "1.1.1",
    "yauzl": "3.4.0",
    "yet-another-react-lightbox": "3.32.2",
    "zip-stream": "7.0.5",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/busboy": "1.5.4",
    "@types/node": "24.13.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "@types/yauzl": "3.4.0",
    "@types/zip-stream": "7.0.0",
    "auth": "1.7.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "prettier": "3.9.6",
    "smtp-server": "3.19.17",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
